{
  "name": "sondc-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/prepare-fonts.mjs && next build --webpack",
    "start": "next start",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "postinstall": "prisma generate && node scripts/prepare-fonts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:check": "node --import tsx scripts/check-setup.ts",
    "admin:grant": "node --import tsx scripts/grant-admin.ts",
    "db:setup": "pnpm db:deploy && pnpm db:seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.80.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dejavu-fonts-ttf": "2.37.3",
    "dotenv": "^17.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.10",
    "prisma": "^7.0.0",
    "sass": "^1.93.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@10.34.7"
}
